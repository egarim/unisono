<Page
    x:Class="UnoPupusas.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="480">
            <TextBlock Text="🫓 Pupusa Party — Uno" FontSize="26" />
            <TextBlock Text="A little C# + XAML for an AI-friendly UI." TextWrapping="Wrap" />
            <TextBlock Text="Quantity" />
            <NumberBox x:Name="QuantityInput" Value="3" Minimum="0"
                       ValueChanged="OnValueChanged" />
            <TextBlock Text="Price (USD)" />
            <NumberBox x:Name="PriceInput" Value="1.75" Minimum="0" SmallChange="0.25"
                       ValueChanged="OnValueChanged" />
            <Button Content="Calculate with MCP" Click="Calculate_Click" />
            <TextBlock x:Name="TotalText" Text="Server total: —" FontSize="22" />
            <TextBlock Text="Requires an MCP Apps host and the bundled JavaScript bridge."
                       Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
