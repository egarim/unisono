<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UnisonoNotes.Pages.NoteDetailPage"
             Title="Note">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label x:Name="TitleLabel" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="MetaLabel" FontSize="12" TextColor="Gray" />
            <Border Padding="12" Stroke="#DDDDDD" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                <Label x:Name="BodyLabel" FontSize="15" LineBreakMode="WordWrap" />
            </Border>
            <Label Text="Open action items" FontSize="13" FontAttributes="Bold" TextColor="#1b4b9b" />
            <VerticalStackLayout x:Name="ItemsLayout" Spacing="6" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
