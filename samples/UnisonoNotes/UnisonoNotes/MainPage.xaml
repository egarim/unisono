<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UnisonoNotes.Models"
             x:Class="UnisonoNotes.MainPage"
             Title="Unisono Notes">
    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0">
        <Label Grid.Row="0"
               Text="Lines that start with '- [ ]' are action items. Ask Siri, Shortcuts or an MCP client to extract them."
               FontSize="13" TextColor="Gray" Margin="0,0,0,10" />
        <CollectionView Grid.Row="1" x:Name="NotesView" SelectionMode="Single" SelectionChanged="OnNoteSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <Border Padding="14,12" Margin="0,0,0,10" Stroke="#DDDDDD" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Preview}" FontSize="13" TextColor="Gray" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="{Binding Summary}" FontSize="12" TextColor="#1b4b9b" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
