<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Pupuseria.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Pupuseria.Pages"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#C8432B"
    Shell.TabBarTitleColor="#C8432B"
    Shell.TabBarUnselectedColor="#7A6A5C"
    Shell.NavBarIsVisible="False">
    <TabBar>
        <Tab Title="Menú" Icon="tab_menu.png" Route="menu">
            <ShellContent ContentTemplate="{DataTemplate pages:MenuPage}" />
        </Tab>
        <Tab Title="Arma la tuya" Icon="tab_build.png" Route="build">
            <ShellContent ContentTemplate="{DataTemplate pages:BuildPage}" />
        </Tab>
        <Tab Title="Pedido" Icon="tab_cart.png" Route="cart">
            <ShellContent ContentTemplate="{DataTemplate pages:CartPage}" />
        </Tab>
        <Tab Title="Estado" Icon="tab_status.png" Route="status">
            <ShellContent ContentTemplate="{DataTemplate pages:StatusPage}" />
        </Tab>
    </TabBar>
</Shell>
