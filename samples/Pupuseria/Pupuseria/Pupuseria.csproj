<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Pupuseria</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Pupusería</ApplicationTitle>
		<ApplicationId>com.unisono.samples.pupuseria</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFF6E5" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFF6E5" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Unisono: the registry and the in-app MCP server everywhere; App Intents on Apple (Swift generated from the
	     C# tools, plus the hand-written AppIntents/ folder); AppFunctions on Android. -->
	<PropertyGroup>
		<_UnisonoPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_UnisonoPlatform>
		<_UnisonoApple Condition="'$(_UnisonoPlatform)' == 'ios' Or '$(_UnisonoPlatform)' == 'maccatalyst'">true</_UnisonoApple>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\..\src\Unisono.Core\Unisono.Core.csproj" />
		<ProjectReference Include="..\..\..\src\Unisono.Mcp\Unisono.Mcp.csproj" />
		<ProjectReference Include="..\..\..\src\Unisono.AppIntents\Unisono.AppIntents.csproj" Condition="'$(_UnisonoApple)' == 'true'" />
		<ProjectReference Include="..\..\..\src\Unisono.AppFunctions\Unisono.AppFunctions.csproj" Condition="'$(_UnisonoPlatform)' == 'android'" />
	</ItemGroup>
	<Import Project="..\..\..\src\Unisono.AppIntents\build\Unisono.AppIntents.targets" Condition="'$(_UnisonoApple)' == 'true'" />
	<ItemGroup Condition="'$(_UnisonoPlatform)' == 'android'">
		<AndroidAsset Include="Platforms\Android\Assets\app_functions.xml" Link="Assets\app_functions.xml" />
	</ItemGroup>

</Project>
