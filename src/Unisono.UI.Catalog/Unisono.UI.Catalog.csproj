<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Unisono.UI.Catalog</RootNamespace>
    <Description>Declarative, server-authored UI documents and one generic renderer for Unisono MCP tools.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Unisono.Core/Unisono.Core.csproj" />
    <ProjectReference Include="../Unisono.McpApps/Unisono.McpApps.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="renderer.html" />
    <EmbeddedResource Include="renderer.js" />
    <None Include="catalog.v1.json" Pack="true" PackagePath="catalog" />
  </ItemGroup>
</Project>
