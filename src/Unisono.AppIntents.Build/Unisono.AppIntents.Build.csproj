<Project Sdk="Microsoft.NET.Sdk">

  <!-- MSBuild tasks for Unisono.AppIntents: writes the Swift intents Xcode project and generates Swift from the app's
       compiled tools. Ships inside the Unisono.AppIntents package under tools/; never referenced by app code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Unisono.AppIntents.Build</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.13.26" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="7.0.0" />
  </ItemGroup>

</Project>
