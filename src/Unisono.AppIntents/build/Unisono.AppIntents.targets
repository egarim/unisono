<Project>
  <!--
    Unisono.AppIntents build glue (iOS and Mac Catalyst).

    1. Before the SDK builds Xcode projects, write the app's Swift intents project itself. After the C# compile, the
       generator reads the app assembly and writes Swift for every [McpServerTool] (intents, AppEnums, Codable DTOs,
       AppEntity + query per IEntityQuery<T>, default App Shortcut phrases). The app may add or replace any of it with
       its own Swift in AppIntents/ next to the csproj (override with $(UnisonoAppIntentsDir)); a hand-written struct,
       enum or AppShortcutsProvider with the same name wins. The package's native/UnisonoBridge.swift is referenced in
       place. Everything is mirrored under obj/ next to a generated .xcodeproj, so the SDK's change detection sees
       every file, and an <XcodeProject> item is added for the SDK's own _BuildXcodeProjects. An app that declares its
       own <XcodeProject> items, or sets $(UnisonoGenerateXcodeProject)=false, is left alone;
       $(UnisonoGenerateSwift)=false keeps the project generation but not the Swift generation.
    2. After the Xcode project builds, pull Metadata.appintents out of the xcarchive (App Intents are discovered
       from this folder, never at runtime).
    3. Copy it into the app bundle so iOS finds the intents.
    Paths are computed inside the targets: at import time $(IntermediateOutputPath) may not be set yet.
  -->
  <PropertyGroup>
    <UnisonoGenerateXcodeProject Condition="'$(UnisonoGenerateXcodeProject)' == ''">true</UnisonoGenerateXcodeProject>
    <UnisonoAppIntentsDir Condition="'$(UnisonoAppIntentsDir)' == ''">$(MSBuildProjectDirectory)/AppIntents</UnisonoAppIntentsDir>
    <UnisonoBridgeSwift Condition="'$(UnisonoBridgeSwift)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../native/UnisonoBridge.swift'))</UnisonoBridgeSwift>
  </PropertyGroup>

  <PropertyGroup>
    <UnisonoGenerateSwift Condition="'$(UnisonoGenerateSwift)' == ''">true</UnisonoGenerateSwift>
    <!-- The MSBuild tasks: tools/ in the package, or the Build project's output in the source tree. -->
    <UnisonoBuildTasksAssembly Condition="'$(UnisonoBuildTasksAssembly)' == '' And Exists('$(MSBuildThisFileDirectory)../tools/Unisono.AppIntents.Build.dll')">$(MSBuildThisFileDirectory)../tools/Unisono.AppIntents.Build.dll</UnisonoBuildTasksAssembly>
    <UnisonoBuildTasksAssembly Condition="'$(UnisonoBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../../Unisono.AppIntents.Build/bin/$(Configuration)/net10.0/Unisono.AppIntents.Build.dll</UnisonoBuildTasksAssembly>
  </PropertyGroup>
  <UsingTask TaskName="Unisono.AppIntents.Build.UnisonoWriteXcodeProject" AssemblyFile="$(UnisonoBuildTasksAssembly)" />
  <UsingTask TaskName="Unisono.AppIntents.Build.UnisonoGenerateSwift" AssemblyFile="$(UnisonoBuildTasksAssembly)" />

  <!-- 1. Write the Swift intents project before the SDK builds Xcode projects (MaciOSPrepareForBuild precedes
          _BuildXcodeProjects in the SDK's build order). -->
  <!-- Runs the C# compile early, through the same chain CoreBuild uses up to Compile (PrepareResources matters: MAUI
       adds the XAML embedded resources there, and it is a sibling of Compile, not a prerequisite). The generator then
       reads the compiled app assembly. The SDK links the Xcode output only in the later native steps, so this order is
       safe (verified on both samples). -->
  <Target Name="_UnisonoPrepareXcodeProject"
          AfterTargets="MaciOSPrepareForBuild"
          DependsOnTargets="BuildOnlySettings;PrepareForBuild;PreBuildEvent;ResolveReferences;PrepareResources;ResolveKeySource;Compile"
          Condition="'$(UnisonoGenerateXcodeProject)' == 'true' And '@(XcodeProject->Count())' == '0' And $([MSBuild]::IsOSPlatform('osx'))">
    <PropertyGroup>
      <UnisonoIntentsModuleName Condition="'$(UnisonoIntentsModuleName)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(AssemblyName)', '[^A-Za-z0-9_]', ''))Intents</UnisonoIntentsModuleName>
      <UnisonoIntentsBundleId Condition="'$(UnisonoIntentsBundleId)' == ''">$(ApplicationId).intents</UnisonoIntentsBundleId>
      <UnisonoIntentsDeploymentTarget Condition="'$(UnisonoIntentsDeploymentTarget)' == ''">$(SupportedOSPlatformVersion)</UnisonoIntentsDeploymentTarget>
      <UnisonoIntentsDeploymentTarget Condition="'$(UnisonoIntentsDeploymentTarget)' == ''">17.0</UnisonoIntentsDeploymentTarget>
      <_UnisonoXcodeMirror>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)unisono/xcode/', '$(MSBuildProjectDirectory)'))</_UnisonoXcodeMirror>
    </PropertyGroup>
    <ItemGroup>
      <_UnisonoSwift Include="$(UnisonoAppIntentsDir)/**/*.swift" />
      <_UnisonoSharedSwift Include="$(UnisonoBridgeSwift)" />
    </ItemGroup>
    <Error Condition="!Exists('$(UnisonoBridgeSwift)')" Text="Unisono: the bridge source $(UnisonoBridgeSwift) is missing." />
    <Error Condition="!Exists('$(UnisonoBuildTasksAssembly)')" Text="Unisono: the build tasks assembly $(UnisonoBuildTasksAssembly) is missing." />
    <!-- Swift from the C# tools (intents, enums, DTOs, entities, phrases); hand-written files in AppIntents/ win by name. -->
    <UnisonoGenerateSwift Condition="'$(UnisonoGenerateSwift)' == 'true'"
                          AppAssembly="@(IntermediateAssembly->'%(FullPath)')" References="@(ReferencePathWithRefAssemblies)"
                          HandWrittenSwift="@(_UnisonoSwift)" OutputDir="$(_UnisonoXcodeMirror)generated-src">
      <Output TaskParameter="GeneratedFiles" ItemName="_UnisonoGeneratedSwift" />
    </UnisonoGenerateSwift>
    <Message Importance="high" Condition="'@(_UnisonoSwift)' == '' And '@(_UnisonoGeneratedSwift)' == ''"
             Text="Unisono: no tools found in the app and no Swift under $(UnisonoAppIntentsDir); no App Intents framework will be built." />
    <UnisonoWriteXcodeProject Condition="'@(_UnisonoSwift)' != '' Or '@(_UnisonoGeneratedSwift)' != ''"
                              SwiftFiles="@(_UnisonoSwift)" SwiftRoot="$(UnisonoAppIntentsDir)" SharedFiles="@(_UnisonoSharedSwift)" GeneratedFiles="@(_UnisonoGeneratedSwift)"
                              OutputDir="$(_UnisonoXcodeMirror)" Name="$(UnisonoIntentsModuleName)" BundleId="$(UnisonoIntentsBundleId)"
                              DeploymentTarget="$(UnisonoIntentsDeploymentTarget)" MacCatalyst="true">
      <Output TaskParameter="ProjectPath" PropertyName="_UnisonoXcodeProjectPath" />
    </UnisonoWriteXcodeProject>
    <ItemGroup Condition="'$(_UnisonoXcodeProjectPath)' != ''">
      <XcodeProject Include="$(_UnisonoXcodeProjectPath)">
        <SchemeName>$(UnisonoIntentsModuleName)</SchemeName>
        <ForceLoad>true</ForceLoad>
        <SmartLink>false</SmartLink>
      </XcodeProject>
    </ItemGroup>
    <Message Importance="high" Condition="'$(_UnisonoXcodeProjectPath)' != ''"
             Text="Unisono: Swift intents framework $(UnisonoIntentsModuleName): @(_UnisonoSwift->Count()) hand-written file(s) in $(UnisonoAppIntentsDir), @(_UnisonoGeneratedSwift->Count()) generated" />
  </Target>

  <!-- 2. After the Xcode project builds, pull Metadata.appintents out of the xcarchive. -->
  <Target Name="_UnisonoExtractAppIntentsMetadata"
          AfterTargets="_BuildXcodeProjects"
          Condition="'@(XcodeProject->Count())' != '0'">
    <PropertyGroup>
      <_UnisonoXcodeDir>$(IntermediateOutputPath)xcode</_UnisonoXcodeDir>
      <_UnisonoMetadataDir>$(_UnisonoXcodeDir)/Metadata.appintents</_UnisonoMetadataDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_UnisonoMetadataDir)" Condition="Exists('$(_UnisonoMetadataDir)')" />
    <Exec Command="SRC=%24(find &quot;$(_UnisonoXcodeDir)&quot; -path '*/archives/*Metadata.appintents' -type d | head -1); if [ -n &quot;%24SRC&quot; ]; then cp -R &quot;%24SRC&quot; &quot;$(_UnisonoMetadataDir)&quot; &amp;&amp; echo &quot;Unisono: extracted Metadata.appintents&quot;; else echo &quot;Unisono: WARNING no Metadata.appintents in the xcarchive (does the Swift target import AppIntents?)&quot;; fi" />
  </Target>

  <!-- 3. Copy it into the app bundle so iOS finds the intents. -->
  <Target Name="_UnisonoCopyAppIntentsMetadata"
          AfterTargets="_CopyResourcesToBundle"
          Condition="'@(XcodeProject->Count())' != '0'">
    <PropertyGroup>
      <_UnisonoMetadataDir>$(IntermediateOutputPath)xcode/Metadata.appintents</_UnisonoMetadataDir>
      <!-- iOS bundles are flat; Mac Catalyst (and macOS) bundles keep resources under Contents/Resources. -->
      <_UnisonoBundleResources>$(AppBundleDir)</_UnisonoBundleResources>
      <_UnisonoBundleResources Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' Or '$(TargetPlatformIdentifier)' == 'macos'">$(AppBundleDir)/Contents/Resources</_UnisonoBundleResources>
    </PropertyGroup>
    <ItemGroup>
      <_UnisonoMetadataFiles Include="$(_UnisonoMetadataDir)/**/*" Condition="Exists('$(_UnisonoMetadataDir)')" />
    </ItemGroup>
    <!-- Keep the explicit slash: AppBundleDir may have no trailing separator, and metadata outside the bundle fails silently. -->
    <Copy SourceFiles="@(_UnisonoMetadataFiles)" DestinationFolder="$(_UnisonoBundleResources)/Metadata.appintents/%(RecursiveDir)" Condition="'@(_UnisonoMetadataFiles)' != ''" />
    <Message Importance="high" Text="Unisono: copied Metadata.appintents into $(_UnisonoBundleResources)" Condition="'@(_UnisonoMetadataFiles)' != ''" />
    <Warning Text="Unisono: no Metadata.appintents was extracted; Siri and Shortcuts will not see this app's intents." Condition="'@(_UnisonoMetadataFiles)' == ''" />
  </Target>
</Project>
