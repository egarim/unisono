<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Unisono.AppIntents</RootNamespace>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <Description>Unisono: connects an app's Swift App Intents to the ToolRegistry through one generic JSON bridge, and ships the MSBuild targets that put Metadata.appintents into the app bundle.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Unisono.Core\Unisono.Core.csproj" />
    <ProjectReference Include="..\Unisono.AppIntents.Binding\Unisono.AppIntents.Binding.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\Unisono.AppIntents.targets" Pack="true" PackagePath="build" />
    <None Include="native\UnisonoBridge.swift" Pack="true" PackagePath="native" />
    <!-- The MSBuild tasks (Xcode project writer, Swift generator) ship under tools/; built first, never referenced. -->
    <ProjectReference Include="..\Unisono.AppIntents.Build\Unisono.AppIntents.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_UnisonoPackBuildTasks</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_UnisonoPackBuildTasks" Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <ItemGroup>
      <_UnisonoBuildTaskFiles Include="..\Unisono.AppIntents.Build\bin\$(Configuration)\net10.0\*.dll" />
      <TfmSpecificPackageFile Include="@(_UnisonoBuildTaskFiles)" PackagePath="tools/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
